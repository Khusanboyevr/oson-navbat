# Get a free API key at https://developer.tech.yandex.ru/ (JavaScript API and Geosuggest)
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Your production URL — used for SEO metadata (canonical links, OpenGraph image resolution).
# Defaults to https://oson-navbat.vercel.app if unset; override if your Vercel project uses a different domain.
NEXT_PUBLIC_SITE_URL=

# Supabase project credentials — find these in Project Settings > API at https://supabase.com/dashboard.
# Until both are set, auth (Google/phone login) runs in demo mode: the UI flow works but no real
# account is created. The app never fails to build or run without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
