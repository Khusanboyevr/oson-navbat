# ---------------------------------------------------------------- required

# Google OAuth Client ID (type: "Web application") from
# https://console.cloud.google.com/apis/credentials
# Sign-in is Google-only, so nobody can log in until this is set.
# Add your origins under "Authorized JavaScript origins":
#   http://localhost:3000  and  https://qulaynavbat.uz
# Both variables must hold the SAME value — the public one renders Google's
# button in the browser, the server one verifies the ID token it returns.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# The real backend's base URL (Django REST, cookie-based auth — see lib/api-client.ts
# and lib/server/backend.ts).
# Note: CORS on the backend is only open for qulaynavbat.uz/www.qulaynavbat.uz, but the
# app now calls it from the server (route handlers), so localhost development works.
NEXT_PUBLIC_API_URL=https://api.qulaynavbat.uz/api/v1

# ---------------------------------------------------------------- optional

# Comma-separated emails that get the super admin role the moment they sign in.
# If left empty, the FIRST account to sign in becomes the super admin (bootstrap).
SUPER_ADMIN_EMAILS=

# Where the app's own store keeps users, worker applications and barber profiles
# (see src/lib/server/store.ts). Defaults to <project>/.data.
# On a serverless host that path is ephemeral — point this at a mounted volume.
DATA_DIR=

# Your production URL — used for SEO metadata (canonical links, OpenGraph image
# resolution). Defaults to https://oson-navbat.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=
