# Get a free API key at https://developer.tech.yandex.ru/ (JavaScript API and Geosuggest)
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Your production URL — used for SEO metadata (canonical links, OpenGraph image resolution).
# Defaults to https://oson-navbat.vercel.app if unset; override if your Vercel project uses a different domain.
NEXT_PUBLIC_SITE_URL=

# Supabase project credentials — find these in Project Settings > API at https://supabase.com/dashboard.
# Until both are set, auth (Google/phone login) runs in demo mode: the UI flow works but no real
# account is created. The app never fails to build or run without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID) key pair — generate your own with `npx web-push generate-vapid-keys`.
# Until both are set, the notification permission prompt/subscribe flow no-ops (demo mode),
# same as the Supabase vars above. VAPID_PRIVATE_KEY must stay server-only (never expose it
# with a NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for the /api/cron/reminders endpoint — Vercel Cron sends it as a Bearer token
# automatically once set here and in the Vercel project's environment variables. Optional locally.
CRON_SECRET=
